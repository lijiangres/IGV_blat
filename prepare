需要修改三处：


# ① 参考基因组路径（改成你的实际路径）
ref_dict = {
    "ref_name1": "/home/jiangli/genomes/twoBit/AP_555_genome.2bit",  # 或 .2bit 文件
    # 如果只有一个物种，ref_name2 可以重复填同一个路径
    "ref_name2": "/home/jiangli/genomes/twoBit/AP_555_genome.2bit"
}

# ② 物种关键词匹配（db 参数来自 IGV 传入的基因组名）
def query_seq_db(db):
    db = db.lower()
    if "ap_555" in db:          # ← 改成你基因组名里的关键词
        return ref_dict["ref_name1"]
    else:
        return ref_dict["ref_name1"]

# ③ blat 可执行文件路径
blat = "/home/jiangli/bin/x86_64/blat"  # ← 改成你的实际路径


