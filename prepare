#设置开机启动
cat >> ~/.bashrc << 'EOF'

# 自动启动 BLAT Flask 服务
if ! ss -tlnp | grep -q 5000; then
    cd ~/blat_server && source venv/bin/activate
    python myBlat.py > ~/blat_server/server.log 2>&1 &
    echo "BLAT server started on port 5000"
fi
EOF



